{
  "name": "detect-grid",
  "description": "Detect and mark grid cells for easy styling",
  "version": "2.1.0",
  "author": "Philipp Daun <daun@daun.ltd>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "npm run lint && npm run cover",
    "test:only": "npm run build && NODE_OPTIONS='--import tsx/esm' mocha --timeout 15000 test/*.ts",
    "test:watch": "npm test -- --watch",
    "cover": "nyc --check-coverage npm run test:only",
    "cover:lcov": "nyc --reporter=lcov npm run test:only",
    "cover:codecov": "npm run cover:lcov && cat ./coverage/lcov.info | codecov",
    "lint": "eslint src test",
    "build": "tsdown",
    "release": "npm run build && git commit -am v$npm_package_version && git tag v$npm_package_version && git push && git push --tags && npm publish"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/daun/detect-grid"
  },
  "keywords": [
    "javascript",
    "grid",
    "position",
    "column",
    "row",
    "visual",
    "flex",
    "flexbox",
    "offset"
  ],
  "bugs": {
    "url": "https://github.com/daun/detect-grid/issues"
  },
  "homepage": "https://github.com/daun/detect-grid",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "chai": "^6.2.2",
    "codecov": "^3.8.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.6.0",
    "mocha": "^11.2.2",
    "nyc": "^18.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "serve-handler": "^6.1.6",
    "tsdown": "^0.22.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0"
  }
}
